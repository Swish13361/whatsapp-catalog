# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/aether

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# CORS - comma separated list of allowed origins
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-admin-domain.com

# USDT Wallet Addresses
USDT_TRC20_ADDRESS=TRC20_WALLET_ADDRESS_HERE
USDT_BEP20_ADDRESS=0xBEP20_WALLET_ADDRESS_HERE
USDT_BINANCE_ADDRESS=0xBINANCE_WALLET_ADDRESS_HERE

# M-Pesa (optional)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
PUBLIC_BASE_URL=https://your-api-domain.onrender.com
STK_CALLBACK_SECRET=your_callback_secret
MPESA_SKIP_VERIFY=true

# Server
PORT=3000